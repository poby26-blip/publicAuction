# ==============================================================================
# [공매이지] 환경변수 템플릿 (.env.example)
# 본 파일을 복사하여 .env.development 또는 .env.production을 생성하십시오.
# ==============================================================================

# 공공데이터포털(data.go.kr) 한국자산관리공사 차세대 온비드 일반 인증키 (Decoding 키)
VITE_PUBLIC_DATA_API_KEY=your_api_key_here

# API Base URL (개발 환경: /api/public-data, 운영 환경: 운영 엔드포인트 URL)
VITE_API_BASE_URL=/api/public-data

