# ==============================================================================
# [공매이지] 프로덕션 운영 환경설정 (.env.production)
# Vite는 'npm run build' 실행 시 본 파일을 자동으로 우선 로드합니다.
# 운영용 공공데이터포털 인증키 및 운영 서버 Base URL을 아래에 기입하십시오.
# ==============================================================================

# 운영용 공공데이터포털(data.go.kr) 한국자산관리공사 차세대 온비드 일반 인증키 (Decoding 키)
# [추후 입력 요망]
VITE_PUBLIC_DATA_API_KEY=

# 운영 배포 API Base URL (예: Nginx/Cloudflare 리버스 프록시 /api/public-data 또는 게이트웨이 도메인)
# [추후 입력 요망]
VITE_API_BASE_URL=

